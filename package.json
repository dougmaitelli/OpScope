{
  "name": "opsscope-workspace",
  "private": true,
  "version": "0.5.0",
  "workspaces": [
    "apps/web"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "26.6.3"
  },
  "scripts": {
    "build": "npm run contracts:check && cargo build --workspace && npm run build --workspace @opsscope/web",
    "check": "npm run contracts:check && cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace --all-targets && npm run check --workspace @opsscope/web",
    "contracts:check": "cargo run --quiet -p opsscope-core --bin export-contracts -- check",
    "contracts:generate": "cargo run --quiet -p opsscope-core --bin export-contracts -- generate",
    "desktop:build": "cd apps/desktop && tauri build --no-bundle",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "icons:generate": "node scripts/generate-icons.mjs",
    "server:dev": "cargo run -p opsscope-server",
    "web:dev": "npm run dev --workspace @opsscope/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:docker": "sh scripts/e2e-docker.sh",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "screenshots": "playwright test --config playwright.docs.config.ts",
    "screenshots:docker": "sh scripts/screenshots-docker.sh"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
